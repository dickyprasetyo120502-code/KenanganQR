# GOOGLE AUTHENTICATION & APP URL
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APP_URL=https://kenangan-qr.vercel.app

# SUPABASE POSTGRESQL CONFIGURATION
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# EXPRESS SERVER PORT (Optional, default: 5000)
PORT=5000

# PRISMA POSTGRESQL CONNECTION STRING
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Contoh Direct: postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
# Contoh Pooler: postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"
# MIDTRANS SANDBOX CONFIGURATION
MIDTRANS_SERVER_KEY=your_midtrans_server_key
VITE_MIDTRANS_CLIENT_KEY=your_midtrans_client_key